{
    "$schema": "https://raw.githubusercontent.com/infection/infection/0.29.0/resources/schema.json",
    "source": {
        "directories": [
            "src/Spinneret",
        ],
        "excludes": [
            "src/Spinneret/Application/var", // Generated because of mutation testing
            "/Module\\.php$/",
            "/CompilerPass\\.php$/",
            "Runner/Backend", // Backend cannot be tested properly
        ]
    },
    "timeout": 30,
    "mutators": {
        "@default": true,
        "CastString": false,
        "CastArray": false,
        "CastInt": false,
    },
    "logs": {
        html: "infection-log.html",
    },
    "bootstrap": "tests/infection-bootstrap.php",
    "minMsi": 90,
}
